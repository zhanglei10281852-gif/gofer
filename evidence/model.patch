+func contactMoveByCard(profile *models.ContactProfile, cardID string) (models.ContactMove, bool) {
+	if profile == nil {
+		return models.ContactMove{}, false
+	}
+	for _, move := range profile.Moves {
+		if move.SourceCardID == cardID && move.Phase != models.ContactMovePhaseDone {
+			return move, true
+		}
+	}
+	return models.ContactMove{}, false
+}
+
+func contactRecentDoneMove(profile *models.ContactProfile) (models.ContactMove, bool) {
+	if profile == nil {
+		return models.ContactMove{}, false
+	}
+	for _, move := range profile.Moves {
+		if move.Phase == models.ContactMovePhaseDone {
+			return move, true
+		}
+	}
+	return models.ContactMove{}, false
+}
+
+func contactActiveMove(profile *models.ContactProfile) (models.ContactMove, bool) {
+	if profile == nil {
+		return models.ContactMove{}, false
+	}
+	for _, move := range profile.Moves {
+		if move.Phase != models.ContactMovePhaseDone {
+			return move, true
+		}
+	}
+	return models.ContactMove{}, false
+}
+
+func contactMoveBookLabel(accounts []models.Account, accountID, bookID string) string {
+	label := contactAccountLabelSimple(accountID, accounts)
+	for _, account := range accounts {
+		if account.ID != accountID {
+			continue
+		}
+		for _, book := range account.ContactAddressBooks {
+			if book.ID == bookID {
+				return label + " / " + contactAddressBookDisplayName(book)
+			}
+		}
+	}
+	if bookID != "" {
+		return label + " / " + bookID
+	}
+	return label
+}
+
+func contactAccountLabelSimple(accountID string, accounts []models.Account) string {
+	for _, account := range accounts {
+		if account.ID == accountID {
+			if name := strings.TrimSpace(account.Name); name != "" {
+				return name
+			}
+			return account.Email
+		}
+	}
+	return accountID
+}
+
+// contactMoveTargetBooks lists connected CardDAV books that may receive a
+// copy, excluding the copy's current book.
+func contactMoveTargetBooks(accounts []models.Account, sourceAccountID, sourceBookID string) []models.ContactAddressBook {
+	var books []models.ContactAddressBook
+	for _, account := range accounts {
+		for _, book := range account.ContactAddressBooks {
+			if account.ID == sourceAccountID && book.ID == sourceBookID {
+				continue
+			}
+			books = append(books, book)
+		}
+	}
+	return books
+}
+
+func contactMovePhaseText(phase string) string {
+	switch phase {
+	case models.ContactMovePhasePrepared:
+		return "Starting the move"
+	case models.ContactMovePhaseCopying:
+		return "Copying the vCard to the new book"
+	case models.ContactMovePhaseCopied:
+		return "Copy confirmed; removing the source copy"
+	case models.ContactMovePhaseDeleting:
+		return "Removing the source copy"
+	case models.ContactMovePhaseSourceConflict:
+		return "The source copy changed after it was copied"
+	case models.ContactMovePhaseBlockedTarget:
+		return "The destination book already holds a different contact"
+	case models.ContactMovePhaseBlockedAccount:
+		return "An account involved in the move is unavailable"
+	case models.ContactMovePhaseRetry:
+		return "Waiting to retry the move"
+	default:
+		return "Moving the copy"
+	}
+}
+
+func contactMoveEndLabel(end string, accounts []models.Account, move models.ContactMove) string {
+	switch end {
+	case models.ContactMoveEndSource:
+		return contactMoveBookLabel(accounts, move.SourceAccountID, move.SourceBookID)
+	case models.ContactMoveEndTarget:
+		return contactMoveBookLabel(accounts, move.TargetAccountID, move.TargetBookID)
+	}
+	return ""
+}
