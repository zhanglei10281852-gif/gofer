+// ContactMovesBanner renders every move for a profile; it doubles as the
+// polling endpoint response.
+templ ContactMovesBanner(profile *models.ContactProfile, accounts []models.Account) {
+	{{
+		var active []models.ContactMove
+		var pollMove *models.ContactMove
+		var recentDone *models.ContactMove
+		if profile != nil {
+			for i := range profile.Moves {
+				move := profile.Moves[i]
+				if move.Phase == models.ContactMovePhaseDone {
+					if recentDone == nil {
+						m := move
+						recentDone = &m
+					}
+					continue
+				}
+				active = append(active, move)
+				switch move.Phase {
+				case models.ContactMovePhasePrepared, models.ContactMovePhaseCopying, models.ContactMovePhaseCopied, models.ContactMovePhaseDeleting, models.ContactMovePhaseRetry:
+					if pollMove == nil {
+						m := move
+						pollMove = &m
+					}
+				}
+			}
+		}
+	}}
+	<div id="contact-moves-banner" class="space-y-2" data-contact-moves>
+		for _, move := range active {
+			@ContactMoveInlineBanner(profile.ID, move, accounts)
+		}
+		if pollMove != nil {
+			<div hx-get={ fmt.Sprintf("/api/contacts/%s/move/%s", profile.ID, pollMove.ID) } hx-trigger="every 2s" hx-swap="outerHTML" hx-target="#contact-moves-banner"></div>
+		} else if recentDone != nil {
+			// Polling endpoint landing here refreshes the whole detail once.
+			<div hx-get={ fmt.Sprintf("/contacts?partial=detail&contact=%s", profile.ID) } hx-trigger="load" hx-target="#mail-view" hx-swap="innerHTML">
+				@ContactMoveDoneBanner(recentDone, accounts)
+			</div>
+		}
+	</div>
+}
+
+templ ContactMoveInlineBanner(contactID string, move models.ContactMove, accounts []models.Account) {
+	<div class="rounded-md border px-3 py-2.5 text-sm" data-contact-move-id={ move.ID } data-contact-move-phase={ move.Phase }>
+		switch move.Phase {
+			case models.ContactMovePhasePrepared, models.ContactMovePhaseCopying, models.ContactMovePhaseCopied, models.ContactMovePhaseDeleting:
+				<div class="flex items-center gap-2 border-sky-500/20 bg-sky-50 text-sky-800">
+					@icon.LoaderCircle(icon.Props{Class: "size-4 shrink-0 animate-spin"})
+					<div class="min-w-0">
+						<div class="font-semibold">{ contactMovePhaseText(move.Phase) }</div>
+						<div class="text-xs opacity-80">
+							From { contactMoveBookLabel(accounts, move.SourceAccountID, move.SourceBookID) } to { contactMoveBookLabel(accounts, move.TargetAccountID, move.TargetBookID) }
+						</div>
+					</div>
+				</div>
+			case models.ContactMovePhaseRetry:
+				<div class="space-y-2 border-amber-500/20 bg-amber-50 text-amber-800">
+					<div class="flex items-center gap-2">
+						@icon.RefreshCw(icon.Props{Class: "size-4 shrink-0"})
+						<div class="min-w-0">
+							<div class="font-semibold">Waiting to retry the move</div>
+							if move.LastError != "" {
+								<div class="text-xs opacity-80">{ move.LastError }</div>
+							}
+						</div>
+					</div>
+					@ContactMoveContinueButton(contactID, move, "continue", "Continue now")
+				</div>
+			case models.ContactMovePhaseSourceConflict:
+				<div class="space-y-2 border-amber-500/20 bg-amber-50 text-amber-800">
+					<div class="flex items-start gap-2">
+						@icon.BadgeAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
+						<div class="min-w-0">
+							<div class="font-semibold">The source copy changed after it was copied</div>
+							<p class="mt-0.5 text-xs leading-relaxed opacity-90">
+								The original book now holds a newer version. Copy the newer version and remove the source, or keep both copies.
+							</p>
+						</div>
+					</div>
+					<div class="flex flex-wrap gap-2">
+						@ContactMoveContinueButton(contactID, move, "recopy", "Copy newer version & delete source")
+						@ContactMoveContinueButton(contactID, move, "keep_both", "Keep both copies")
+					</div>
+				</div>
+			case models.ContactMovePhaseBlockedTarget:
+				<div class="space-y-2 border-red-500/20 bg-red-50 text-red-800">
+					<div class="flex items-start gap-2">
+						@icon.BadgeAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
+						<div class="min-w-0">
+							<div class="font-semibold">Destination already holds a different contact</div>
+							<p class="mt-0.5 text-xs leading-relaxed opacity-90">Gofer did not overwrite it. Choose another book or cancel the move.</p>
+						</div>
+					</div>
+					<form class="flex flex-wrap items-center gap-2" hx-post={ fmt.Sprintf("/api/contacts/%s/move/%s/continue", contactID, move.ID) } hx-target="#mail-view" hx-swap="innerHTML">
+						<input type="hidden" name="action" value="retarget"/>
+						<select name="target_book_id" class="h-9 rounded-md border border-red-300 bg-white px-2 text-xs text-ink" required>
+							<option value="" disabled selected>Choose another book…</option>
+							for _, book := range contactMoveTargetBooks(accounts, move.SourceAccountID, move.SourceBookID) {
+								if book.ID != move.TargetBookID {
+									<option value={ book.ID }>{ contactMoveBookLabel(accounts, book.AccountID, book.ID) }</option>
+								}
+							}
+						</select>
+						<button type="submit" class="inline-flex h-9 items-center rounded-md bg-ink px-3 text-xs font-semibold text-paper">Choose another book</button>
+					</form>
+					@ContactMoveContinueButton(contactID, move, "cancel", "Cancel move")
+				</div>
+			case models.ContactMovePhaseBlockedAccount:
+				<div class="space-y-2 border-red-500/20 bg-red-50 text-red-800">
+					<div class="flex items-start gap-2">
+						@icon.BadgeAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
+						<div class="min-w-0">
+							<div class="font-semibold">An account involved in the move is unavailable</div>
+							<div class="mt-0.5 text-xs opacity-80">
+								{ contactMoveEndLabel(move.FailedEnd, accounts, move) }
+							</div>
+							if move.LastError != "" {
+								<div class="mt-1 break-words text-xs opacity-90">{ move.LastError }</div>
+							}
+							<p class="mt-1 text-xs opacity-90">Reconnect the account, then continue. The copied content and the source copy are both intact.</p>
+						</div>
+					</div>
+					<div class="flex flex-wrap gap-2">
+						@ContactMoveContinueButton(contactID, move, "continue", "Continue")
+						@ContactMoveContinueButton(contactID, move, "cancel", "Cancel move")
+					</div>
+				</div>
+		}
+	</div>
+}
