package views

import (
	"github.com/cristianadrielbraun/gofer/components/icon"
)

// SendSchedulePanel hosts the recurring-plan cards app.js renders above the
// pending single-schedule drafts in the Scheduled folder.
templ SendSchedulePanel() {
	<section class="border-b border-border/70 bg-muted/20" data-send-schedule-panel aria-label="Recurring sends">
		<div class="flex items-center justify-between px-3 pt-2">
			<div class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">
				@icon.CalendarClock(icon.Props{Class: "size-3.5"})
				Recurring
			</div>
		</div>
		<div class="flex flex-col gap-2 p-3" data-send-schedule-list>
			<p class="text-xs text-muted-foreground" data-send-schedule-empty hidden>No recurring sends yet.</p>
		</div>
	</section>
}
